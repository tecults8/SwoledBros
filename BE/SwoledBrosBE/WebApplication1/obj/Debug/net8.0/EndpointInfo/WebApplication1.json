            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "WorkoutSplitDto": {
        "type": "object",
        "properties": {
          "day": {
            "type": "string",
            "nullable": true
          },
          "exercises": {
            "type": "array",
